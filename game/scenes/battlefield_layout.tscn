[ext_resource type="Script" path="res://scripts/battlefield_layout.gd" id="1_layout"]

[node name="BattlefieldLayout" type="Node2D"]
editor_description = "전장 좌표 편집 전용 씬입니다. Marker2D를 이동해 적 경로, 패배 지점과 타워 슬롯을 조정합니다. 자식 노드의 순서와 개수는 게임 로직에서 사용하므로 바꾸지 마세요."
script = ExtResource("1_layout")

[node name="MonsterRoute" type="Node2D" parent="."]
editor_description = "자식 Marker2D의 순서가 실제 몬스터 이동 순서입니다. 위치만 이동하고 순서와 개수(9개)는 유지하세요."

