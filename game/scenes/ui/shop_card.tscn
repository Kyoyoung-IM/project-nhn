[sub_resource type="Shader" id="ShaderPriceGoldGrayscale"]
code = "shader_type canvas_item;\n\nvarying vec4 canvas_modulate;\nuniform float price_gold_grayscale : hint_range(0.0, 1.0) = 0.0;\n\nvoid vertex() {\n\tcanvas_modulate = COLOR;\n}\n\nvoid fragment() {\n\tvec4 texture_color = texture(TEXTURE, UV);\n\tvec4 frame_color = texture_color * canvas_modulate;\n\tfloat price_region = step(0.755, UV.y);\n\tfloat warm_red = step(texture_color.b + 0.025, texture_color.r);\n\tfloat warm_green = step(texture_color.b + 0.01, texture_color.g);\n\tfloat chroma = max(texture_color.r, max(texture_color.g, texture_color.b)) - min(texture_color.r, min(texture_color.g, texture_color.b));\n\tfloat colored_gold = step(0.06, chroma);\n\tfloat gold_mask = price_region * warm_red * warm_green * colored_gold * price_gold_grayscale;\n\tfloat luminance = dot(frame_color.rgb, vec3(0.299, 0.587, 0.114));\n\tCOLOR = vec4(mix(frame_color.rgb, vec3(luminance), gold_mask), frame_color.a);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterialPriceGoldGrayscale"]
resource_local_to_scene = true
shader = SubResource("ShaderPriceGoldGrayscale")
shader_parameter/price_gold_grayscale = 0.0

